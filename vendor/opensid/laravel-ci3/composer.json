{
    "name": "opensid/laravel-ci3",
    "description": "Laravel-CodeIgniter 3 Integration Bridge - Middleware and utilities for running CI3 within Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "codeigniter",
        "ci3",
        "bridge",
        "integration",
        "opensid"
    ],
    "authors": [
        {
            "name": "OpenSID Team"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "OpenSID\\LaravelCI3\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
